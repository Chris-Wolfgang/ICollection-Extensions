<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Native AOT test run (fleet standard, 2026-10-30).

	  Runs the SAME unit tests as Wolfgang.Extensions.ICollection.Tests.Unit, compiled as a
	  Native AOT executable with xUnit v3. The 2.x project stays as it is for every TFM; this
	  one exists only to prove the library under trimming + AOT, which a JIT test run cannot.

	  The test sources are linked, not copied: fix a test in Tests.Unit and it is fixed here.
	  xUnit v3's in-process console runner makes this project its own executable (no
	  Microsoft.NET.Test.Sdk), and with PublishAot that executable is a native binary.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<!-- Not a dotnet-test project: build-pr.ps1 runs `dotnet test` only on IsTestProject /
		     Microsoft.NET.Test.Sdk projects. This one is published and executed by the AOT job. -->
		<IsTestProject>false</IsTestProject>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<IsAotCompatible>true</IsAotCompatible>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<!-- The unit tests use no real cultures, so ICU is not needed. -->
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<!-- The AOT (source-generated) edition of xUnit.net v3: test discovery, theory data and attribute
		     configuration are resolved at build time, so no reflection is needed at run time. The plain
		     `xunit.v3` package is reflection-based and cannot run under Native AOT. Requires net9.0+ and C#. -->
		<PackageReference Include="xunit.v3.aot" Version="4.0.3" />
		<!-- The SDK picks the ILCompiler that matches the installed SDK (10.0.11), which carries
		     GHSA-p3jp-9v83-76w9 (Brotli decoder out-of-bounds write, fixed in 10.0.14) and fails the
		     warnings-as-errors build with NU1903. An explicit reference overrides the implicit one. -->
		<PackageReference Include="Microsoft.DotNet.ILCompiler" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Wolfgang.Extensions.ICollection\Wolfgang.Extensions.ICollection.csproj" />
	</ItemGroup>

	<!-- The unit tests themselves, linked from the 2.x project. -->
	<ItemGroup>
		<Compile Include="..\Wolfgang.Extensions.ICollection.Tests.Unit\**\*.cs" Exclude="..\Wolfgang.Extensions.ICollection.Tests.Unit\obj\**;..\Wolfgang.Extensions.ICollection.Tests.Unit\bin\**" Link="Unit\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
